rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hdgaishs24@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Public read for official media
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
