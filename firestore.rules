rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hdgaishs24@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // App Settings
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid']) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Series Collection
    match /series/{seriesId} {
      allow get: if isValidId(seriesId) && (resource.data.published == true || isAdmin());
      allow list: if true;
      allow write: if isAdmin();
    }

    // Seasons Collection
    match /seasons/{seasonId} {
      allow get: if isValidId(seasonId) && (resource.data.published == true || isAdmin());
      allow list: if true;
      allow write: if isAdmin();
    }

    // Episodes Collection
    match /episodes/{episodeId} {
      allow get: if isValidId(episodeId) && (resource.data.published == true || isAdmin());
      allow list: if true;
      allow write: if isAdmin();
    }

    // Comments Collection
    match /comments/{commentId} {
      allow get, list: if true;
      allow create: if isGoogleUser() &&
        incoming().userId == request.auth.uid &&
        incoming().text is string &&
        incoming().text.size() > 0 &&
        incoming().text.size() <= 1000;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt'])) ||
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['reported']))
      );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reactions Collection
    match /reactions/{reactionId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Watch History Collection
    match /watchHistory/{historyId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
